{
  "name": "@zapsaang/dsh-web-bridge",
  "version": "0.1.0-alpha.2",
  "description": "Unix-socket session bridge for DeepSeek Harness behind Cloudflare Access, packaged as a Cordis plugin.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zapsaang/dsh-web-bridge.git"
  },
  "homepage": "https://github.com/zapsaang/dsh-web-bridge#readme",
  "bugs": {
    "url": "https://github.com/zapsaang/dsh-web-bridge/issues"
  },
  "keywords": [
    "deepseek",
    "dsh",
    "cordis",
    "cloudflare-access",
    "unix-socket"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "alpha",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/dsh/index.d.ts",
      "default": "./lib/dsh/index.js"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml"
      ]
    }
  },
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@deepseek-ai/dsh": "0.2.1-alpha.1",
    "@deepseek-ai/schemastery": "3.18.5-alpha.1"
  },
  "scripts": {
    "build": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('lib', { recursive: true, force: true });\" && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('.test-dist', { recursive: true, force: true });\" && tsc -p tsconfig.test.json && node --test .test-dist/test/*.test.js",
    "prepack": "npm run build && node scripts/check-pack-files.mjs",
    "soak": "tsc -p tsconfig.test.json --outDir .test-dist-soak && node scripts/soak.mjs"
  },
  "packageManager": "pnpm@12.9.1",
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@deepseek-ai/dsh": "0.2.1-alpha.1",
    "@deepseek-ai/schemastery": "3.18.5-alpha.1",
    "@types/node": "24.19.1",
    "playwright": "1.63.0",
    "typescript": "7.0.2"
  }
}
